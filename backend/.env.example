# Copie para .env e preencha. No Render, cadastre as mesmas variáveis em Environment.

# IA (Groq) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Origens do frontend liberadas no CORS, separadas por vírgula
CLAREIA_CORS_ORIGINS=http://localhost:3000

# JWT - gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Professor criado automaticamente na primeira inicialização
ADMIN_USERNAME=professor
ADMIN_PASSWORD=
ADMIN_NAME=Professor(a)

# Opcional: caminho do arquivo SQLite
# CLAREIA_DATABASE_PATH=data/clareia.sqlite3
